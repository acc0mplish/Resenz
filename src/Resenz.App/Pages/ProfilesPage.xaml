<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Resenz.App.Pages.ProfilesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Resenz.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Resenz.App.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:PageHeader Grid.Row="0" MaxWidth="1064" Margin="36,24,36,0"
                          Title="구독 관리"
                          Subtitle="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

        <!-- 가져오기 영역 별도 행, 제목 표시줄 컨트롤 과다 방지 -->
        <Grid Grid.Row="1" MaxWidth="1064" Margin="36,0,36,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     VerticalAlignment="Center"
                     PlaceholderText="구독 주소를 입력하세요"
                     Text="{x:Bind ViewModel.ImportUrl, Mode=TwoWay}" />
            <TextBox Grid.Column="1"
                     VerticalAlignment="Center"
                     PlaceholderText="이름(선택)"
                     Text="{x:Bind ViewModel.ImportName, Mode=TwoWay}" />
            <Button Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ImportUrlCommand}"
                    Content="가져오기" />
            <Button Grid.Column="3"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ImportFileCommand}"
                    Content="파일에서 가져오기" />
            <Button Grid.Column="4"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.RefreshAllCommand}"
                    Content="전체 새로고침" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Padding="36,0,36,0">
            <Border>
            <GridView ItemsSource="{x:Bind ViewModel.Items}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      MaxWidth="{StaticResource PageContentMaxWidth}"
                      Padding="0,0,0,24">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 항목 폭 300 고정: 창이 넓을수록 열이 많아지고 최소 폭에서도 2열 유지 -->
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="300" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileRowViewModel">
                        <Grid Style="{StaticResource CardStyle}"
                                MinHeight="140"
                                Padding="16,14"
                                Tag="{x:Bind}"
                                Tapped="Card_Tapped">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="16" Height="16" CornerRadius="8"
                                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon FontSize="9" Glyph="&#xE73E;" Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind Name}" />
                                        <Border CornerRadius="4" Padding="5,1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind IsFree, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="10" Text="무료 노드"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="28" Height="28">
                                        <ProgressRing Width="18" Height="18"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsActive="{x:Bind IsRefreshing, Mode=OneWay}"
                                                      Visibility="{x:Bind IsRefreshing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Width="28" Height="28"
                                                ToolTipService.ToolTip="새로고침"
                                                Tag="{x:Bind}"
                                                Click="Refresh_Click"
                                                Visibility="{x:Bind IsRefreshing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                        </Button>
                                    </Grid>
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                            Width="28" Height="28"
                                            ToolTipService.ToolTip="더 보기">
                                        <FontIcon FontSize="12" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="이 설정 사용"
                                                                IsEnabled="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                                                Tag="{x:Bind}"
                                                                Click="Activate_Click" />
                                                <MenuFlyoutItem Text="구독 정보 편집"
                                                                Tag="{x:Bind}"
                                                                Click="EditInfo_Click" />
                                                <MenuFlyoutItem Text="설정 편집"
                                                                Tag="{x:Bind}"
                                                                Click="Edit_Click" />
                                                <MenuFlyoutItem Text="이름 변경"
                                                                Tag="{x:Bind}"
                                                                Click="Rename_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="삭제"
                                                                Tag="{x:Bind}"
                                                                Click="Delete_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind KindText}" />
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Width="20" Height="20" Padding="2"
                                                VerticalAlignment="Center"
                                                Tag="{x:Bind}"
                                                Click="ToggleTime_Click"
                                                ToolTipService.ToolTip="클릭으로 만료 시각 / 갱신 시각 전환 표시">
                                            <FontIcon FontSize="8" Glyph="&#xE823;" />
                                        </Button>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind ToggleTimeText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                   Text="{x:Bind UsageText}" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind ExpireText}" />
                                    </StackPanel>
                                    <ProgressBar Maximum="100"
                                                 Value="{x:Bind UsagePercent}"
                                                 Height="4"
                                                 Visibility="{x:Bind HasUsageBar, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            </Border>
        </ScrollViewer>

        <!-- 설정 편집 대형 다이얼로그: 페이지 전체를 덮고 최대화 가능. 원본 설정은 편집 가능 / runtime 설정은 읽기 전용 미리보기 -->
        <Grid Grid.RowSpan="3"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsEditorOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Border x:Name="EditorPanel"
                    Margin="40"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid Padding="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="최대화/복원"
                                Click="ToggleEditorMaximize_Click">
                            <FontIcon x:Name="EditorMaximizeIcon" FontSize="12" Glyph="&#xE740;" />
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="닫기"
                                Command="{x:Bind ViewModel.CloseEditorCommand}">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <SelectorBar x:Name="EditorTabs" Grid.Row="1" Margin="0,0,0,12"
                                 SelectionChanged="EditorTabs_SelectionChanged">
                        <SelectorBarItem Text="원본 설정" IsSelected="True" />
                        <SelectorBarItem Text="runtime 설정" />
                    </SelectorBar>

                    <Grid Grid.Row="2">
                        <TextBox x:Name="RawEditor"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 IsSpellCheckEnabled="False"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Text="{x:Bind ViewModel.EditorText, Mode=TwoWay}"
                                 Visibility="{x:Bind ViewModel.IsRawTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 IsSpellCheckEnabled="False"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Text="{x:Bind ViewModel.RuntimePreview, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.IsRuntimeTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressRing Width="28" Height="28"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsEditorBusy, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsEditorBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Click="SaveEditor_Click"
                                Content="저장 후 적용" />
                        <Button Command="{x:Bind ViewModel.CloseEditorCommand}"
                                Content="취소" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
