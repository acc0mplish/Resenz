<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Resenz.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Resenz.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 카드 간격, WinUI Gallery 설정 페이지 패턴에 맞춤 -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    </Page.Resources>

    <Grid x:Name="RootGrid" RowSpacing="16" IsTabStop="True" Tapped="Root_Tapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:PageHeader Grid.Row="0" MaxWidth="1064" Margin="36,24,36,0"
                          Title="앱 설정"
                          Subtitle="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch"
                      Padding="36,0,36,0">
            <Border>
            <StackPanel Padding="0,0,0,24" MaxWidth="{StaticResource PageContentMaxWidth}"
                        Spacing="{StaticResource SettingsCardSpacing}">
                <!-- 공식 패턴: 엇갈린 재배열 애니메이션을 끄고 펼치기/접기 때 아래 그룹이 개별 전달 대신 전체적으로 부드럽게 따라오게 함 -->
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <controls:SettingsExpander Header="모양">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="테마">
                        <ComboBox x:Name="ThemeBox" Width="160" SelectionChanged="Theme_SelectionChanged">
                            <ComboBoxItem Content="시스템 따름" />
                            <ComboBoxItem Content="라이트" />
                            <ComboBoxItem Content="다크" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="창 배경 소재, 전환 후 즉시 적용" Header="배경 소재">
                        <ComboBox Width="160"
                                  SelectedIndex="{x:Bind ViewModel.BackdropStyle, Mode=TwoWay}">
                            <ComboBoxItem Content="아크릴" />
                            <ComboBoxItem Content="Mica" />
                            <ComboBoxItem Content="단색" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="탐색 모음 위치, 전환 후 즉시 적용" Header="탐색 스타일">
                        <ComboBox Width="160"
                                  SelectedIndex="{x:Bind ViewModel.NavigationStyle, Mode=TwoWay}">
                            <ComboBoxItem Content="좌측" />
                            <ComboBoxItem Content="상단" />
                        </ComboBox>
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="시작과 실행">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="현재 사용자의 시작 항목에 등록" Header="부팅 자동 시작">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.StartupWithWindows, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="부팅 자동 시작 때 메인 창 미표시" Header="조용한 시작">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.SilentStart, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="실행할 때마다 트레이로 바로 최소화. 메인 창을 띄우지 않고 트레이와 미니 패널만 유지" Header="시작 시 트레이로 최소화">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="앱 시작 후 코어 자동 기동" Header="시작 시 코어 자동 실행">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AutoStartCore, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="앱 시작 후 구독 자동 새로고침" Header="시작 시 구독 갱신">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AutoUpdateProfileOnStart, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="코어 미실행 시 앱 자동 종료" Header="코어 없으면 자동 종료">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AutoQuitWithoutCore, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="코어 정지 후 대기 시간(초)" Header="자동 종료 지연">
                        <TextBox Width="120" Tag="AutoQuitWithoutCoreDelay"
                                 Text="{x:Bind ViewModel.AutoQuitWithoutCoreDelay, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="단축키">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="입력 상자에서 조합키를 누르면 기록됨. Backspace로 비움. 수정키는 최소 하나 포함" Header="메인 화면 표시">
                        <TextBox x:Name="HotkeyShowWindowBox" Width="220" Tag="ShowWindow"
                                 PlaceholderText="예: Ctrl+Alt+M"
                                 IsReadOnly="True"
                                 Text="{x:Bind ViewModel.HotkeyShowWindow, Mode=TwoWay}"
                                 KeyDown="Hotkey_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="시스템 프록시 전환">
                        <TextBox x:Name="HotkeySystemProxyBox" Width="220" Tag="ToggleSystemProxy"
                                 PlaceholderText="예: Ctrl+Alt+P"
                                 IsReadOnly="True"
                                 Text="{x:Bind ViewModel.HotkeyToggleSystemProxy, Mode=TwoWay}"
                                 KeyDown="Hotkey_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="TUN 모드 전환">
                        <TextBox x:Name="HotkeyTunBox" Width="220" Tag="ToggleTun"
                                 PlaceholderText="예: Ctrl+Alt+T"
                                 IsReadOnly="True"
                                 Text="{x:Bind ViewModel.HotkeyToggleTun, Mode=TwoWay}"
                                 KeyDown="Hotkey_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="펼치기와 접기가 같은 키를 공유. 다시 누르면 접힘" Header="미니 패널 전환">
                        <TextBox x:Name="HotkeyMiniPanelBox" Width="220" Tag="ToggleMiniPanel"
                                 PlaceholderText="예: Ctrl+Alt+B"
                                 IsReadOnly="True"
                                 Text="{x:Bind ViewModel.HotkeyToggleMiniPanel, Mode=TwoWay}"
                                 KeyDown="Hotkey_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="규칙 모드">
                        <TextBox x:Name="HotkeyRuleBox" Width="220" Tag="ModeRule"
                                 PlaceholderText="예: Ctrl+Alt+1"
                                 IsReadOnly="True"
                                 Text="{x:Bind ViewModel.HotkeyModeRule, Mode=TwoWay}"
                                 KeyDown="Hotkey_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="전역 모드">
                        <TextBox x:Name="HotkeyGlobalBox" Width="220" Tag="ModeGlobal"
                                 PlaceholderText="예: Ctrl+Alt+2"
                                 IsReadOnly="True"
                                 Text="{x:Bind ViewModel.HotkeyModeGlobal, Mode=TwoWay}"
                                 KeyDown="Hotkey_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="직접 모드">
                        <TextBox x:Name="HotkeyDirectBox" Width="220" Tag="ModeDirect"
                                 PlaceholderText="예: Ctrl+Alt+3"
                                 IsReadOnly="True"
                                 Text="{x:Bind ViewModel.HotkeyModeDirect, Mode=TwoWay}"
                                 KeyDown="Hotkey_KeyDown" />
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="프록시" Description="Windows 인터넷 프록시가 로컬 혼합 포트를 가리키도록 설정">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.SystemProxyEnabled, Mode=TwoWay}" />
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="PAC: 로컬 PAC 스크립트로 더 정밀한 분기. 수동: 프록시 서버에 바로 지정" Header="프록시 모드">
                        <ComboBox x:Name="SystemProxyModeBox" Width="160" SelectionChanged="SystemProxyMode_SelectionChanged">
                            <ComboBoxItem Content="수동" />
                            <ComboBoxItem Content="PAC" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="LAN 연결 허용">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AllowLan, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="IPv6">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Ipv6, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="노드 전환 후 이전 연결을 자동으로 닫음" Header="노드 전환 시 연결 자동 종료">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AutoCloseConnection, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="구독과 다운로드">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="구독 요청에 사용할 User-Agent. 비워 두면 기본값 사용" Header="User-Agent">
                        <TextBox Width="360" Tag="SubscriptionUserAgent"
                                 PlaceholderText="clash-verge/v1.0.0"
                                 Text="{x:Bind ViewModel.SubscriptionUserAgent, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="구독 다운로드 시간 초과(초)" Header="구독 시간 초과">
                        <TextBox Width="120" Tag="SubscriptionTimeout"
                                 Text="{x:Bind ViewModel.SubscriptionTimeout, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="코어와 구독을 다운로드할 때 거치는 우회 경로. 비워 두면 GitHub에 직접 연결" Header="다운로드 우회 경로">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="GithubProxyBox" Width="200" SelectionChanged="GithubProxy_SelectionChanged">
                                <ComboBoxItem Content="자동" />
                                <ComboBoxItem Content="직접 연결" />
                                <ComboBoxItem Content="사용자 지정" />
                            </ComboBox>
                            <TextBox x:Name="GithubProxyCustomBox" Width="220" Tag="GithubProxyCustom"
                                     PlaceholderText="https://your-proxy"
                                     Text="{x:Bind ViewModel.GithubProxyCustom, Mode=TwoWay}"
                                     LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                        </StackPanel>
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="지연 측정">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="측정에 사용할 대상 주소" Header="테스트 주소">
                        <TextBox Width="360" Tag="DelayTestUrl"
                                 PlaceholderText="https://www.gstatic.com/generate_204"
                                 Text="{x:Bind ViewModel.DelayTestUrl, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="1회 측정 시간 초과(밀리초)" Header="시간 초과">
                        <TextBox Width="120" Tag="DelayTestTimeout"
                                 Text="{x:Bind ViewModel.DelayTestTimeout, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="전체 측정 동시 실행 수" Header="동시 실행 수">
                        <TextBox Width="120" Tag="DelayTestConcurrency"
                                 Text="{x:Bind ViewModel.DelayTestConcurrency, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="TUN 모드" Description="관리자 권한 필요. 전환 후 코어 자동 재시작">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE701;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.TunEnabled, Mode=TwoWay}" />
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="네트워크 스택 구현 방식. 전환 후 코어 재시작 시 적용" Header="Stack">
                        <ComboBox x:Name="TunStackBox" Width="160" SelectionChanged="TunStack_SelectionChanged">
                            <ComboBoxItem Content="mixed" />
                            <ComboBoxItem Content="gvisor" />
                            <ComboBoxItem Content="system" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="라우팅 테이블 자동 구성" Header="자동 라우팅">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.TunAutoRoute, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="트래픽 자동 리다이렉트(Linux/일부 환경)" Header="자동 리다이렉트">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.TunAutoRedirect, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="출구 네트워크 어댑터 자동 감지" Header="인터페이스 자동 감지">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.TunAutoDetectInterface, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="엄격 라우팅. 트래픽이 TUN을 우회하지 못하게 막음" Header="엄격 라우팅">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.TunStrictRoute, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="MTU. 비워 두면 기본값" Header="MTU">
                        <TextBox Width="120" Tag="TunMtu"
                                 PlaceholderText="1500"
                                 Text="{x:Bind ViewModel.TunMtu, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="DNS 가로채기 대상. 줄마다 하나씩, 기본값 any:53" Header="DNS 가로채기">
                        <TextBox Width="360" AcceptsReturn="True" Height="72" Tag="TunDnsHijack"
                                 PlaceholderText="any:53"
                                 TextWrapping="Wrap"
                                 Text="{x:Bind ViewModel.TunDnsHijack, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="라우팅에서 제외할 주소 대역. 줄마다 CIDR 하나씩" Header="제외 주소">
                        <TextBox Width="360" AcceptsReturn="True" Height="72" Tag="TunRouteExcludeAddress"
                                 PlaceholderText="10.0.0.0/8"
                                 TextWrapping="Wrap"
                                 Text="{x:Bind ViewModel.TunRouteExcludeAddress, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="관리자 권한으로 코어 실행, TUN 모드용" Header="상승 호스트 상태">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{x:Bind ViewModel.ElevatedHostStatus, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="상승 호스트 제어">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.LaunchElevatedHostCommand}" Content="상승 호스트 기동" />
                            <Button Command="{x:Bind ViewModel.ShutdownElevatedHostCommand}" Content="상승 호스트 종료" />
                        </StackPanel>
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="SSID 연동">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE904;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="목록의 WiFi에 연결되면 시스템 프록시를 자동으로 끄고, 떠나면 복원. 줄마다 SSID 하나씩">
                        <TextBox Width="240" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="예: &#x0a;CoffeeShop&#x0a;Home-WiFi"
                                 Tag="PauseSsids"
                                 Text="{x:Bind ViewModel.PauseSsids, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="목록의 WiFi에 연결되면 해당 구독으로 자동 전환. 줄 형식: SSID&#x9;구독 이름">
                        <TextBox Width="240" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="예: &#x0a;Office-WiFi&#x9;회사 구독&#x0a;Home-WiFi&#x9;집 구독"
                                 Tag="SsidProfileMap"
                                 Text="{x:Bind ViewModel.SsidProfileMap, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" />
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="코어 파라미터">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE713;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="로컬 프록시 수신 포트. Enter 키 또는 포커스 이탈 시 저장" Header="혼합 포트">
                        <TextBox Width="160" Tag="MixedPort"
                                 Text="{x:Bind ViewModel.MixedPort, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="RESTful 제어 인터페이스 포트. Enter 키 또는 포커스 이탈 시 저장" Header="제어 포트">
                        <TextBox Width="160" Tag="ControllerPort"
                                 Text="{x:Bind ViewModel.ControllerPort, Mode=TwoWay}"
                                 LostFocus="TextField_LostFocus" KeyDown="TextField_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="실행 모드는 상단 제목 표시줄에서 전환" Header="실행 모드">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.Mode, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="로그 레벨">
                        <ComboBox x:Name="LogLevelBox" Width="160" SelectionChanged="LogLevel_SelectionChanged">
                            <ComboBoxItem Content="조용함" />
                            <ComboBoxItem Content="오류" />
                            <ComboBoxItem Content="경고" />
                            <ComboBoxItem Content="정보" />
                            <ComboBoxItem Content="디버그" />
                        </ComboBox>
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="버전과 업데이트">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="{x:Bind ViewModel.AppStatusText, Mode=OneWay}" Header="앱 버전">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16"
                                          IsActive="{x:Bind ViewModel.IsAppBusy, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsAppBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button MinWidth="0" Padding="10,4"
                                    Command="{x:Bind ViewModel.CheckAppCommand}"
                                    Content="업데이트 검사" />
                            <Button MinWidth="0" Padding="10,4"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.UpdateAppCommand}"
                                    Content="{x:Bind ViewModel.UpdateAppButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="acc0mplish/Resenz 공식 Release에서 다운로드" Header="앱 최신 버전">
                        <StackPanel Spacing="6" MinWidth="240">
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.LatestAppVersion, Mode=OneWay}" />
                            <ProgressBar Maximum="100"
                                         Value="{x:Bind ViewModel.AppProgress, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.AppProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="시작 후 백그라운드에서 GitHub 릴리스를 검사해 새 버전 발견 시 상단에 알림"
                                           Header="앱 업데이트 자동 검사">
                        <ToggleSwitch MinWidth="0"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind ViewModel.AutoCheckAppUpdate, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="{x:Bind ViewModel.KernelStatusText, Mode=OneWay}" Header="코어 버전">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.KernelVersion, Mode=OneWay}" />
                            <ProgressRing Width="16" Height="16"
                                          IsActive="{x:Bind ViewModel.IsKernelBusy, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsKernelBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <Button MinWidth="0" Padding="10,4"
                                    Command="{x:Bind ViewModel.CheckKernelCommand}"
                                    Content="업데이트 검사" />
                            <Button MinWidth="0" Padding="10,4"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.UpdateKernelCommand}"
                                    Content="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="MetaCubeX/mihomo 공식 Release에서 다운로드" Header="코어 최신 버전">
                        <StackPanel Spacing="6" MinWidth="240">
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.LatestKernelVersion, Mode=OneWay}" />
                            <ProgressBar Maximum="100"
                                         Value="{x:Bind ViewModel.KernelProgress, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.KernelProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="버전을 골라 코어를 업그레이드. 과거 버전 포함, 완료 후 코어 자동 재시작" Header="코어 버전 선택 후 업그레이드">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="KernelVersionBox" Width="180" Height="32" VerticalAlignment="Center"
                                      PlaceholderText="버전 선택"
                                      ItemsSource="{x:Bind ViewModel.KernelVersions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedKernelVersion, Mode=TwoWay}" />
                            <Button MinWidth="0" Padding="10,4" VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.UpgradeToSelectedCommand}"
                                    Content="이 버전으로 업그레이드" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="현재 코어를 재시작하거나 DNS·FakeIP 캐시를 정리" Header="코어 유지보수">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.RestartCoreCommand}" Content="코어 재시작" />
                            <Button Command="{x:Bind ViewModel.FlushCachesCommand}" Content="DNS 캐시 정리" />
                        </StackPanel>
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="경로">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="데이터 디렉터리">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center"
                                       IsTextSelectionEnabled="True"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.DataDirectory}" />
                            <Button MinWidth="0" Padding="10,4" VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.OpenDataDirectoryCommand}"
                                    Content="열기" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="코어 경로">
                        <TextBlock VerticalAlignment="Center"
                                   IsTextSelectionEnabled="True"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.CorePath}" />
                    </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

            </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
