<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Resenz.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Resenz.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Resenz"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title=""
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Image Width="24" Height="24" VerticalAlignment="Center"
                           Source="ms-appx:///Assets/AppIcon.png" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold"
                               Text="Resenz" />
                </StackPanel>
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontSize="14" VerticalAlignment="Center" Glyph="&#xE774;" />
                        <TextBlock FontSize="14" VerticalAlignment="Center" Text="프록시" />
                        <ToggleSwitch x:Name="SystemProxySwitch"
                                      MinWidth="0"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind ModeSelector.SystemProxyOn, Mode=OneWay}"
                                      Toggled="SystemProxy_Toggled"
                                      ToolTipService.ToolTip="시스템 프록시" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontSize="14" VerticalAlignment="Center" Glyph="&#xE701;" />
                        <TextBlock FontSize="14" VerticalAlignment="Center" Text="TUN" />
                        <ToggleSwitch x:Name="TunSwitch"
                                      MinWidth="0"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind ModeSelector.TunOn, Mode=OneWay}"
                                      Toggled="Tun_Toggled"
                                      ToolTipService.ToolTip="TUN 모드(관리자 권한 필요, 전환 시 코어 재시작)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton x:Name="ModeRuleButton"
                                      MinWidth="0" Padding="14,5"
                                      VerticalAlignment="Center"
                                      Content="규칙"
                                      Tag="0"
                                      Click="ModeButton_Click"
                                      ToolTipService.ToolTip="규칙 모드: 설정 규칙대로 분류" />
                        <ToggleButton x:Name="ModeGlobalButton"
                                      MinWidth="0" Padding="14,5"
                                      VerticalAlignment="Center"
                                      Content="전역"
                                      Tag="1"
                                      Click="ModeButton_Click"
                                      ToolTipService.ToolTip="전역 모드: 모든 트래픽 프록시 경유" />
                        <ToggleButton x:Name="ModeDirectButton"
                                      MinWidth="0" Padding="14,5"
                                      VerticalAlignment="Center"
                                      Content="직접 연결"
                                      Tag="2"
                                      Click="ModeButton_Click"
                                      ToolTipService.ToolTip="직접 모드: 모든 트래픽 프록시 미경유" />
                    </StackPanel>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            OpenPaneLength="200"
            PaneOpened="NavView_PaneChanged"
            PaneClosed="NavView_PaneChanged"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="개요" IsSelected="True" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="프록시" Tag="proxies">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="구독" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="연결" Tag="connections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="규칙" Tag="rules">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="트래픽" Tag="traffic">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="네트워크" Tag="network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="로그" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <controls:PaneSplitter x:Name="PaneSplitter"
                               Grid.Row="1"
                               Width="6"
                               Margin="200,0,0,0"
                               HorizontalAlignment="Left"
                               Background="Transparent"
                               DragStarted="PaneSplitter_DragStarted"
                               Dragged="PaneSplitter_Dragged"
                               DragCompleted="PaneSplitter_DragCompleted" />
    </Grid>
</Window>
